# Copy to .env (never commit .env)
# docker-compose builds DATABASE_URL from these. Use a URL-safe password: openssl rand -hex 24
POSTGRES_USER=oneman
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oneman
# For running the backend outside Docker instead (SQLite if unset):
# DATABASE_URL=postgresql+psycopg2://oneman:change-me@localhost:5432/oneman

# Vultr Serverless Inference (OpenAI-compatible)
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=

# Business rules
APPROVAL_REQUIRED_OVER_USD=5000
INVOICE_PRICE_TOLERANCE_PCT=2.0
LOW_CONFIDENCE_THRESHOLD=0.7
SCORE_WEIGHT_PRICE=0.5
SCORE_WEIGHT_LEAD_TIME=0.3
SCORE_WEIGHT_RATING=0.2

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Public hostname served by Caddy (production)
SITE_ADDRESS=localhost
